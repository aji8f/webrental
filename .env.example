# Copy this file to .env and fill in real values. Never commit .env.

PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/webrentaldb
NODE_ENV=development

# Long random string used to sign admin JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Single hardcoded admin account (no multi-user support yet).
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password. Generate with:
# node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Comma-separated list of origins allowed to call the API cross-origin (browser CORS).
# Leave empty for same-origin-only deployments (the default — Express serves the SPA and API together).
ALLOWED_ORIGINS=

# Telegram bot for uploading portfolio projects (see docs/superpowers/specs for the feature design).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat/user IDs allowed to use the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
