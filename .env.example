# Copy this file to .env and fill in real values. Never commit .env.

PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/webrentaldb
NODE_ENV=development

# Long random string used to sign admin JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Single hardcoded admin account (no multi-user support yet).
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password. Generate with:
# node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Comma-separated list of origins allowed to send credentials (cookies) cross-origin.
# MUST include your production origin(s), e.g. https://yourdomain.com,https://www.yourdomain.com
# — Vite adds a `crossorigin` attribute to built <script>/<link> tags, which makes browsers
# send an Origin header even for the site's own same-origin asset requests. Leaving this
# empty will make the built CSS/JS fail to load in production (blank page).
# Fine to leave empty only for plain local dev via `npm run dev` (Vite's dev server proxies
# /api same-origin, so the browser never sends a cross-origin Origin header to this app).
ALLOWED_ORIGINS=

# Telegram bot for uploading portfolio projects (see docs/superpowers/specs for the feature design).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat/user IDs allowed to use the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
